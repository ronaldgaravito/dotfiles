* {
    bg:            rgba(30, 30, 46, 0.85);
    fg:            #cdd6f4;
    fg-selected:   #1e1e2e;
    red:           #f38ba8;
    green:         #a6e3a1;
    blue:          #89b4fa;
    mauve:         #cba6f7;
    surface0:      rgba(49, 50, 68, 0.6);
    overlay0:      #6c7086;
}

window {
    transparency: "real";
    background-color: transparent;
    text-color: @fg;
    width: 600;
    border-radius: 20px;
    location: center;
    anchor: center;
    fullscreen: false;
    cursor: "default";
}

mainbox {
    background-color: rgba(24, 24, 37, 0.95);
    border-radius: 20px;
    padding: 16px;
    spacing: 12px;
    border: 1px;
    border-color: rgba(203, 166, 247, 0.3);
    children: [inputbar, listview];
}

inputbar {
    background-color: @surface0;
    border-radius: 14px;
    padding: 12px 16px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: @mauve;
}

entry {
    text-color: @fg;
}

listview {
    background-color: transparent;
    padding: 0;
    spacing: 4px;
    columns: 1;
    lines: 8;
    dynamic: true;
    scrollbar: false;
    scrollbar-width: 0;
    fixed-height: 0;
    border: 0;
}

element {
    background-color: transparent;
    text-color: @fg;
    padding: 10px 14px;
    border-radius: 12px;
    spacing: 10px;
    cursor: "pointer";
    highlight: none;
}

element selected.normal {
    background-color: #2b2d42;
    text-color: #ffffff;
    border: 2px;
    border-color: #cba6f7;
    border-radius: 12px;
}

element icon {
    size: 22px;
}

element text {
    text-color: inherit;
}

textbox-prompt-colon {
    expand: false;
    str: "";
    text-color: transparent;
}

sidebar {
    background-color: transparent;
    border: 0;
    padding: 0;
    spacing: 4;
}

button {
    background-color: transparent;
    text-color: @overlay0;
    padding: 6px 8px;
    border-radius: 8px;
    border: 0;
}

button selected {
    background-color: @mauve;
    text-color: @fg-selected;
}

scrollbar {
    width: 0;
    padding: 0;
    handle-width: 0;
    border: 0;
}

case-indicator {
    text-color: transparent;
}

textbox {
    text-color: @fg;
    border: 0;
}

message {
    border: 0;
    background-color: transparent;
}
