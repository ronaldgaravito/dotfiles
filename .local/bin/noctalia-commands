#!/usr/bin/env bash
case "$1" in
  list|--list|-l)
    noctalia msg --help 2>&1 | sed -n '1,500p' | grep "^  [a-z]" | awk '{print $1}'
    ;;
  search|--search|-s)
    shift
    noctalia msg --help 2>&1 | grep -i -- "$*"
    ;;
  explain|--explain|-e)
    shift
    if [ -z "$1" ]; then
      echo "Uso: noctalia-commands explain <comando>"
      exit 1
    fi
    noctalia msg --help 2>&1 | awk -v c="$1" 'match($0, "^  " c "[[:space:]]") {print; exit}'
    ;;
  session)
    noctalia msg session --help 2>&1
    ;;
  *)
    echo "Uso: noctalia-commands {list|search|explain|session}"
    ;;
esac
